# Remember to never publicly share your PRODUCTION keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# app/debug.keystore is the exception: it's a non-secret, checked-in debug
# identity (not used for Play Store signing) that keeps every CI-built APK
# signed identically, so installs upgrade in place instead of requiring an
# uninstall — which would wipe all app data, including downloads.
!app/debug.keystore
